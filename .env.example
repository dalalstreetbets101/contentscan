# Google Gemini API Key for Auto-Compilation
GEMINI_API_KEY=your_gemini_api_key_here

# Notion Configurations (for automatic Notion page creation)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Optional: Google Docs / Sheets Configurations
GOOGLE_CREDENTIALS_JSON=google_credentials.json
GOOGLE_DOCS_FOLDER_ID=your_google_drive_folder_id_here
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_id_here
